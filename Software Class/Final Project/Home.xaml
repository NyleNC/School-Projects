    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" RequestedTheme="Light">

    <Grid RequestedTheme="Light" HorizontalAlignment="Left" Width="1490">
        <TextBlock x:Name="lblClub" HorizontalAlignment="Left" Margin="398,109,0,0" TextWrapping="Wrap" Text="Chaldea Gaming" VerticalAlignment="Top" Width="520" FontSize="72" FontWeight="Bold" FontFamily="Brush Script MT" Foreground="#FF00FFFD"/>
        <TextBlock x:Name="lblWho" HorizontalAlignment="Left" Margin="164,262,0,0" TextWrapping="Wrap" Text="Who We are?" VerticalAlignment="Top" FontWeight="Bold" FontSize="36" FontFamily="Cooper Black" Foreground="#FF1AE9F1"/>
        <Image x:Name="imgLogo" HorizontalAlignment="Left" Height="129" Margin="243,89,0,0" VerticalAlignment="Top" Source="/Assets/Logo.png" Width="150" Stretch="Fill"/>
        <Image x:Name="imgScore" HorizontalAlignment="Left" Height="285" Margin="889,227,0,0" VerticalAlignment="Top" Width="402" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False" d:LayoutRounding="Auto" Source="/Assets/highscore.png" Stretch="Fill">
            <Image.RenderTransform>
