        <TextBlock HorizontalAlignment="Left" Height="666" Margin="127,312,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="654" FontSize="36" Foreground="#FF1AE9F1"><Run Text="Chaldea Gaming Club is a vibrant community of passionate gamers dedicated to creating a welcoming space for gaming enthusiasts of all levels. Founded in 2023, our club has grown to become a hub for like-minded individuals who share a common love for video games and interactive entertainment."/><Run Text=" "/><LineBreak/><Run/><LineBreak/><Run Text="A"/><Run Text="ny age are welcome to join. We have Variety of activities."/></TextBlock>
        <TextBlock x:Name="txtPrice" HorizontalAlignment="Left" Margin="830,527,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="251" Width="217" FontSize="16"  FontWeight="Bold" Foreground="#FF1AE9F1"><Run Text="Our Price are "/><Run Text=":"/><LineBreak/><Run Text="Anime enthusiastic"/><Run Text=" : $20"/><LineBreak/><Run Text="Gaming:$20"/><LineBreak/><Run Text="Content Creator :"/><Run Text=" "/><Run Text="$"/><Run Text="25"/><LineBreak/><Run Text="Developer :"/><Run Text=" "/><Run Text="$27"/><LineBreak/><Run/><LineBreak/><Run Text="Age group prices:"/><LineBreak/><Run Text="5"/><Run Text="-11 : $10"/><LineBreak/><Run Text="12-17 : $13"/><LineBreak/><Run Text="18 and Up:"/><Run Text=" "/><Run Text="$15"/><LineBreak/><Run/></TextBlock>


