<Page
    x:Class="Final_Project.ClubLeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Final_Project"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Height="1072" Width="1562" FocusVisualPrimaryBrush="{x:Null}" Foreground="{x:Null}" FocusVisualSecondaryBrush="{x:Null}" RequestedTheme="Dark">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <RelativePanel x:ConnectionId='2' x:Name="rpClubLeader" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" RequestedTheme="Light" FocusVisualPrimaryBrush="{x:Null}" FocusVisualSecondaryBrush="{x:Null}" Height="1052" Width="766">
            <TextBlock x:ConnectionId='10' x:Name="lblClubLeader" TextWrapping="Wrap" Text="Club Leader Information" FontSize="48" FontWeight="Bold" Margin="12,7,0,0" Foreground="#FF1EF7FF"/>
            <Button x:ConnectionId='11' x:Name="bntContact" Content="Contact" Margin="478,822,0,0" VerticalAlignment="Top" Height="84" Width="181" FontSize="36" FontWeight="Bold" Foreground="White" FontFamily="Cooper Black"                          TabIndex="10">
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="#FF2EC6F1" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            <TextBlock x:ConnectionId='12' x:Name="txtLeader" Height="581" Width="713" TextWrapping="WrapWholeWords" AllowDrop="True" FontSize="24" FontFamily="Bahnschrift SemiCondensed" RequestedTheme="Light" Foreground="#FF1EF7FF" SelectionHighlightColor="{x:Null}" Margin="30,91,9,19"><Run Text="Club Leader - Alex &quot;ShadowPulse&quot; Rodriguez:&#xD;&#xA;&#xD;&#xA;Meet the visionary leader behind Chaldea Gaming Club, Alex &quot;ShadowPulse&quot; Rodriguez. With a passion for gaming that spans decades, Alex founded the club with the vision of creating a space where gamers of all backgrounds could come together. Known for their strategic prowess in both esports and collaborative game development, Alex leads the club with dedication and a commitment to fostering a positive and inclusive gaming community."/><LineBreak/><Run/><LineBreak/><Run Text="&#xD;&#xA;Twitter: [@ShadowPulse]&#xD;&#xA;Discord: [Chaldea#0000]"/></TextBlock>
        </RelativePanel>
        <RelativePanel x:ConnectionId='3' x:Name="rpForm" Grid.Column="1">
            <TextBox x:ConnectionId='4' x:Name="txtFirst" Text="" PlaceholderText="Please Input Name" TextWrapping="Wrap" FontSize="20" Background="#FF1EF7FF" Width="268" TabIndex="10" TextAlignment="Center" Margin="50,100,50,100" HorizontalAlignment="Left" Foreground="#FFDC0E0E" RequestedTheme="Light"/>
            <TextBox x:ConnectionId='5' x:Name="txtEmail" TextWrapping="Wrap" Text="" RelativePanel.AlignRightWith="" RelativePanel.Below="txtFirst" FontSize="20" Width="273" TabIndex="20" Background="#FF1EF7FF" PlaceholderText="Please Input Email" TextAlignment="Center" Margin="50,0,0,0" Foreground="#FFFF1E1E" RequestedTheme="Light" />
            <TextBox x:ConnectionId='6' x:Name="txtMessage" Text="" PlaceholderText="Do you Want to  Message Club Leader?" TextWrapping="Wrap" FontSize="36" Background="#FF1EF7FF" Width="605" TabIndex="19" TextAlignment="Center" Height="166" RelativePanel.Below="txtEmail" Padding="20,16,14,6" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Margin="27,32,0,0" Foreground="#FFFF1E1E" RequestedTheme="Light"/>
            <Button x:ConnectionId='7' x:Name="btnSubmit" Content="Submit" FontSize="48" RelativePanel.Below="txtMessage" Width="277" Margin="400,50,0,0"                         Foreground="White" FontFamily="Cooper Black" TabIndex="60">
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="#FF2AB3DA" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            <TextBlock x:ConnectionId='8' x:Name="lblDis" TextWrapping="Wrap" Text="Do you have discord?" FontSize="24" Foreground="#FF1EF7FF" RelativePanel.Below="btnSubmit" Width="266" Margin="31,0,0,0" FontWeight="Bold"/>
            <RadioButton x:ConnectionId='9' x:Name="radYes" Content="Yes" FontSize="20" RelativePanel.Below="lblDis" FontWeight="Bold" Foreground="#FF1EF7FF" Width="98" Margin="32,0,0,0" TabIndex="40">
                <RadioButton.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="#FF1C57FF" Offset="1"/>
                    </LinearGradientBrush>
                </RadioButton.Background>
            </RadioButton>
            <RadioButton Content="No" FontSize="20" Foreground="#FF1EFFD5" RelativePanel.RightOf="radYes" RelativePanel.Below="lblDis" FontWeight="Bold" Width="91" TabIndex="50">
                <RadioButton.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="#FF1C57FF" Offset="1"/>
                    </LinearGradientBrush>
                </RadioButton.Background>
            </RadioButton>
        </RelativePanel>
        


    </Grid>
</Page>

