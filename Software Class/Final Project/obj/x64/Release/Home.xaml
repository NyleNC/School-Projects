<Page
    x:Class="Final_Project.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Final_Project"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RequestedTheme="Light">

    <Grid>
        <TextBlock x:ConnectionId='2' x:Name="lblClub" HorizontalAlignment="Left" Margin="328,34,0,0" TextWrapping="Wrap" Text="Chaldea Gaming" VerticalAlignment="Top" Width="520" FontSize="72" FontWeight="Bold" FontFamily="Brush Script MT"/>
        <TextBox x:ConnectionId='3' x:Name="txtClubSum" HorizontalAlignment="Left" Height="315" Margin="94,200,0,0" TextWrapping="Wrap" Text="Chaldea Gaming Club is a vibrant community of passionate gamers dedicated to creating a welcoming space for gaming enthusiasts of all levels. Founded in 2023, our club has grown to become a hub for like-minded individuals who share a common love for video games and interactive entertainment." VerticalAlignment="Top" Width="688" FontSize="36" BorderThickness="0,0,0,0" FontFamily="Bahnschrift"/>
        <TextBlock x:ConnectionId='4' x:Name="lblWho" HorizontalAlignment="Left" Margin="94,155,0,0" TextWrapping="Wrap" Text="Who We are?" VerticalAlignment="Top" FontWeight="Bold" FontSize="36" FontFamily="Cooper Black"/>
        <Image x:ConnectionId='5' x:Name="imgLogo" HorizontalAlignment="Left" Height="129" Margin="173,14,0,0" VerticalAlignment="Top" Source="/Assets/Logo.png" Width="150" Stretch="Fill"/>
        <Image x:ConnectionId='6' x:Name="imgScore" HorizontalAlignment="Left" Height="423" Margin="910,196,0,0" VerticalAlignment="Top" Width="501" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False" d:LayoutRounding="Auto" Source="/Assets/highscore.png" Stretch="Fill">
            <Image.RenderTransform>
                <CompositeTransform SkewY="0.562" TranslateY="0.49" SkewX="-0.012" ScaleX="1" ScaleY="1" TranslateX="-0.034"/>
            </Image.RenderTransform>
        </Image>
        <TextBlock x:ConnectionId='7' x:Name="txtHighscore" HorizontalAlignment="Left" Margin="911,119,0,0" TextWrapping="Wrap" Text="High Score on Ones of our Arcade Machines" VerticalAlignment="Top" Width="411" Height="65" FontSize="20" FontWeight="Bold"/>


    </Grid>
</Page>

