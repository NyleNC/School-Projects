<Page
    x:Class="Final_Project.SignUp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Final_Project"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RequestedTheme="Light">

    <Grid>
        <TextBlock x:ConnectionId='2' x:Name="lblSignup" HorizontalAlignment="Left" Margin="156,55,0,0" TextWrapping="Wrap" Text="Sign Up :" VerticalAlignment="Top" Width="125" FontSize="20" FontWeight="Bold"/>
        <TextBox x:ConnectionId='3' x:Name="input" HorizontalAlignment="Left" Margin="296,128,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="206" RenderTransformOrigin="0.045,0.36" PlaceholderText="Please Input First Name" TabIndex="10"/>
        <TextBox x:ConnectionId='4' x:Name="txtLast" HorizontalAlignment="Left" Margin="296,177,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="206" PlaceholderText="Please Input Last Name" TabIndex="20"/>
        <TextBox x:ConnectionId='5' x:Name="txtPhone" HorizontalAlignment="Left" Margin="296,224,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="206" PlaceholderText="111-3333-9999" TabIndex="30"/>
        <TextBlock x:ConnectionId='6' x:Name="lblFirst" HorizontalAlignment="Left" Margin="183,133,0,0" TextWrapping="Wrap" Text="First Name:" VerticalAlignment="Top" FontWeight="Bold" FontSize="16"/>
        <TextBlock x:ConnectionId='7' x:Name="lblLast" HorizontalAlignment="Left" Margin="176,182,0,0" TextWrapping="Wrap" Text="Last Name:" VerticalAlignment="Top" FontWeight="Bold" FontSize="16"/>
        <TextBlock x:ConnectionId='8' x:Name="lblPhone" HorizontalAlignment="Left" Margin="156,229,0,0" TextWrapping="Wrap" Text="Phone Number:" VerticalAlignment="Top" FontWeight="Bold" FontSize="16"/>
        <DatePicker x:ConnectionId='9' x:Name="dtBirthday" Margin="296,273,0,0" VerticalAlignment="Top" CalendarIdentifier="GregorianCalendar"/>
        <TextBlock x:ConnectionId='10' x:Name="txtBirthday" HorizontalAlignment="Left" Margin="183,278,0,0" TextWrapping="Wrap" Text="Birthday:" VerticalAlignment="Top" Width="81" FontWeight="Bold" FontSize="16"/>
        <Button x:ConnectionId='11' x:Name="btnSubmit" Content="Submit" Margin="315,454,0,0" VerticalAlignment="Top" FontWeight="Bold" FontFamily="Arial Rounded MT Bold" Foreground="#FF46ADB1">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FFB11818" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button x:ConnectionId='12' x:Name="btnCancel" Content="Cancel" Margin="517,452,0,0" VerticalAlignment="Top" Foreground="#FF46A5A9" FontFamily="Arial Rounded MT Bold" FontWeight="Bold" FontSize="16">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FF8D1313" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <ComboBox x:ConnectionId='13' x:Name="cboActivity" Margin="296,339,0,0" Width="120">
            <ComboBoxItem Content="Anime Enthusiastic"/>
            <ComboBoxItem Content="Gaming"/>
            <ComboBoxItem Content="Content Creator"/>
            <ComboBoxItem Content="Developer"/>
        </ComboBox>
        <TextBlock x:ConnectionId='14' x:Name="txtCombo" HorizontalAlignment="Left" Margin="136,344,0,0" TextWrapping="Wrap" Text="Type of Activity :" VerticalAlignment="Top" FontWeight="Bold" FontSize="16"/>

    </Grid>
</Page>

