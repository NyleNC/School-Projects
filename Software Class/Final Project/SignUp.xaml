<Page
    x:Class="Final_Project.SignUp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Final_Project"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Width="1586" d:DesignHeight="1066" RequestedTheme="Light" Foreground="{x:Null}" FocusVisualPrimaryBrush="{x:Null}">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65*"/>
            <ColumnDefinition Width="57*"/>
        </Grid.ColumnDefinitions>
        <RelativePanel x:Name="rpSignUp" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="1021" Width="821" Canvas.ZIndex="-2" Margin="14,10,0,0">
            <TextBlock x:Name="lblSignup" TextWrapping="Wrap" Text="Sign Up :" Width="284" FontSize="36" FontWeight="Bold" Margin="65,66,0,0" Foreground="#FF028A57"/>
            <TextBox x:Name="txtFirstName" HorizontalAlignment="Left" Margin="259,199,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="206" RenderTransformOrigin="0.045,0.36" PlaceholderText="Please Input First Name" TabIndex="10" Foreground="#FFF11A91" Background="#FF1AE9F1"/>
            <TextBox x:Name="txtLast" HorizontalAlignment="Left" Margin="259,248,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="206" PlaceholderText="Please Input Last Name" TabIndex="20" Foreground="#FFF11A91" Background="#FF1AE9F1"/>
            <TextBox x:Name="txtPhone" HorizontalAlignment="Left" Margin="259,295,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="206" PlaceholderText="111-3333-9999" TabIndex="30" Background="#FF1AE9F1" Foreground="#FFF11A91"/>
            <TextBlock x:Name="lblFirst" HorizontalAlignment="Left" Margin="115,202,0,0" TextWrapping="Wrap" Text="First Name:" VerticalAlignment="Top" FontWeight="Bold" FontSize="22" Foreground="#FF1AE9F1"/>
            <TextBlock x:Name="lblLast" HorizontalAlignment="Left" Margin="119,251,0,0" TextWrapping="Wrap" Text="Last Name:" VerticalAlignment="Top" FontWeight="Bold" FontSize="22" Foreground="#FF1AE9F1"/>
            <TextBlock x:Name="lblPhone" HorizontalAlignment="Left" Margin="78,297,0,0" TextWrapping="Wrap" Text="Phone Number:" VerticalAlignment="Top" FontWeight="Bold" FontSize="22" Foreground="#FF1AE9F1"/>
            <Button x:Name="btnSubmit" Content="Submit" Margin="211,650,0,0" VerticalAlignment="Top" FontWeight="Bold" FontFamily="Arial Rounded MT Bold" Foreground="#FF46ADB1" Click="btnSubmit_Click" TabIndex="60">
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="#FFB11818" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            <Button x:Name="btnCancel" Content="Cancel" Margin="430,650,0,0" VerticalAlignment="Top" Foreground="#FF46A5A9" FontFamily="Arial Rounded MT Bold" FontWeight="Bold" FontSize="16" Click="btnCancel_Click" TabIndex="70">
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="#FF8D1313" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            <ComboBox x:Name="cboActivity" Margin="407,362,0,0" Width="120" TabIndex="50" Background="#FF1AE9F1">
                <ComboBoxItem Content="None" IsSelected="True"/>
                <ComboBoxItem Content="Anime Enthusiastic"/>
                <ComboBoxItem Content="Gaming"/>
                <ComboBoxItem Content="Content Creator"/>
                <ComboBoxItem Content="Developer"/>
            </ComboBox>
            <TextBlock x:Name="txtCombo" HorizontalAlignment="Left" Margin="543,359,0,0" TextWrapping="Wrap" Text=":Activity " VerticalAlignment="Top" FontWeight="Bold" FontSize="22" Foreground="#FF1AE9F1"/>
            <ComboBox x:Name="cboAge" Margin="242,362,0,0" Width="120" TabIndex="40" Background="#FF1AE9F1">
                <ComboBoxItem Content="None" IsSelected="True"/>
                <ComboBoxItem Content="5-11"/>
                <ComboBoxItem Content="12-17"/>
                <ComboBoxItem Content="18 and Up"/>
            </ComboBox>
            <TextBlock x:Name="txtAge" HorizontalAlignment="Left" Margin="161,364,0,0" TextWrapping="Wrap" Text="Age:" VerticalAlignment="Top" FontWeight="Bold" FontSize="22" Foreground="#FF1AE9F1"/>
            <DatePicker x:Name="datePick" Margin="295,486,0,0" RequestedTheme="Light" Foreground="#FFFF1A1A">
                <DatePicker.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="#FF12C6A5" Offset="1"/>
                    </LinearGradientBrush>
                </DatePicker.Background>
            </DatePicker>
            <TextBlock x:Name="lblDate" TextWrapping="Wrap" Text="Birthday:" RelativePanel.LeftOf="" RelativePanel.AlignLeftWith="" Foreground="#FF17CFD7" FontSize="24" FontWeight="Bold" Margin="184,485,0,0"/>
        </RelativePanel>

        <RelativePanel x:Name="rpOutput"  Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Height="1046" Width="730">
            <TextBlock x:Name="lblOutput" Grid.Column="1" TextWrapping="Wrap" Text="" Height="449" Width="646" FontSize="24" RelativePanel.AlignRightWithPanel="True" Foreground="#FF1AE9F1" Margin="0,44,35,24"/>
            <Button x:Name="btnBack" Content="Back" Margin="117,504,0,0" VerticalAlignment="Top" Foreground="#FF46A5A9" FontFamily="Arial Rounded MT Bold" FontWeight="Bold" FontSize="16" Grid.Column="1" RenderTransformOrigin="1.184,-2.118" Click="btnBack_Click" RelativePanel.AlignHorizontalCenterWithPanel="True" TabIndex="10">
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="#FF8D1313" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </RelativePanel>



    </Grid>
</Page>
